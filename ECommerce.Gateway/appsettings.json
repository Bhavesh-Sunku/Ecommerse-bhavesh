{
  "ReverseProxy": {
    "Routes": {
      "products-read-root": {
        "ClusterId": "products",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/products",
          "Methods": [ "GET" ]
        }
      },
      "products-write-root": {
        "ClusterId": "products",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/products",
          "Methods": [ "POST" ]
        }
      },
      "products-read": {
        "ClusterId": "products",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/products/{**remainder}",
          "Methods": [ "GET" ]
        }
      },
      "products-write": {
        "ClusterId": "products",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/products/{**remainder}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },
      "inventory-read": {
        "ClusterId": "products",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/inventory/{**remainder}",
          "Methods": [ "GET" ]
        }
      },
      "inventory-write-root": {
        "ClusterId": "products",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/inventory",
          "Methods": [ "POST" ]
        }
      },
      "inventory-write": {
        "ClusterId": "products",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/inventory/{**remainder}",
          "Methods": [ "POST", "PUT" ]
        }
      },
      "auth": {
        "ClusterId": "users",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "users": {
        "ClusterId": "users",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/users/{**remainder}"
        }
      },
      "cart-root": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/cart",
          "Methods": [ "GET", "DELETE" ]
        }
      },
      "cart": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/cart/{**remainder}"
        }
      },
      "orders-root": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/orders",
          "Methods": [ "GET" ]
        }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/orders/{**remainder}"
        }
      },
      "payments-root": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/payments",
          "Methods": [ "POST" ]
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/payments/{**remainder}"
        }
      }
    },
    "Clusters": {
      "products": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "users": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5202/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "orders": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5203/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "payments": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5204/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
