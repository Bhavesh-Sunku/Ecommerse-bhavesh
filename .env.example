# Provide reachable SQL Server connection strings for each service.
# For the local-sql Compose profile, use Server=sqlserver,1433 and set the
# same password in each string as MSSQL_SA_PASSWORD below.
IMAGE_TAG=local
PRODUCT_DB_CONNECTION=Server=sqlserver,1433;Database=ECommerceProducts;User Id=sa;Password=CHANGE_ME_SAME_AS_MSSQL_SA_PASSWORD;Encrypt=False;TrustServerCertificate=True;
USER_DB_CONNECTION=Server=sqlserver,1433;Database=ECommerceUsers;User Id=sa;Password=CHANGE_ME_SAME_AS_MSSQL_SA_PASSWORD;Encrypt=False;TrustServerCertificate=True;
ORDER_DB_CONNECTION=Server=sqlserver,1433;Database=ECommerceOrders;User Id=sa;Password=CHANGE_ME_SAME_AS_MSSQL_SA_PASSWORD;Encrypt=False;TrustServerCertificate=True;

# Use a development-only shared key locally. Store production secrets in Azure Key Vault/App Service settings.
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_UTF8_BYTES
JWT_ISSUER=ECommerceAPI
JWT_AUDIENCE=ECommerceClient
PRODUCT_INTERNAL_SERVICE_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
MSSQL_SA_PASSWORD=CHANGE_ME_IF_USING_LOCAL_SQL_PROFILE
PRODUCT_SERVICE_URL=http://product-service:8080/
USER_SERVICE_URL=http://user-service:8080/
ORDER_SERVICE_URL=http://order-service:8080/
ACR_SERVER=example.azurecr.io
ACR_USERNAME=SET_IN_PIPELINE_SECRET_VARIABLES
ACR_PASSWORD=SET_IN_PIPELINE_SECRET_VARIABLES
PAYMENT_DB_CONNECTION=Server=sqlserver,1433;Database=ECommercePayments;User Id=sa;Password=${MSSQL_SA_PASSWORD};Encrypt=False;TrustServerCertificate=True;
PAYMENT_INTERNAL_SERVICE_KEY=REPLACE_WITH_ANOTHER_DIFFERENT_32_BYTE_RANDOM_SECRET
